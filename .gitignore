# =========================
# ROOT .gitignore — aiMart
# =========================

# ---------- Node / JS ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Environment files ----------
.env
.env.local
.env.development
.env.production
.env.test

client/.env
client/.env.*
server/.env
server/.env.*

# ---------- Build outputs ----------
dist/
build/
client/dist/
client/build/
server/dist/

# ---------- Vite ----------
client/.vite/

# ---------- Logs ----------
logs/
*.log

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---------- Coverage ----------
coverage/

# ---------- Cache ----------
.cache/
.parcel-cache/

# ---------- Uploads / Temp files ----------
server/public/temp/
server/public/temp/*.png
server/public/temp/*.jpg
server/public/temp/*.jpeg
server/public/temp/*.gif
server/public/temp/*.webp

# ---------- Database ----------
*.sqlite
*.db

# ---------- Misc ----------
*.tgz
*.swp
